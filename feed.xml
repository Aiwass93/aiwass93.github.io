---
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:base="{{ site.url }}/">
<title>John's website</title>
<link href="{{ site.url }}/"/>
<link rel="self" href="{{ site.url }}/feed.xml"/>
<id>{{ site.url }}/</id>
<updated>{{ site.posts.first.date | date_to_xmlschema }}</updated>
<author><name>John</name></author>
{% for post in site.posts %}<entry>
<title>{{ post.title | xml_escape }}</title>
<link href="{{ site.url }}{{ post.url }}"/>
<id>{{ site.url }}{{ post.url }}</id>
<updated>{{ post.date | date_to_xmlschema }}</updated>
<content type="html" xml:lang="{{ post.lang | escape }}">{{ post.content | xml_escape }}</content>
</entry>
{% endfor %}</feed>

---
---
<?xml version="1.0" encoding="utf-8"?>
{% assign latest = "" %}{% for post in site.posts %}{% assign changed = post.updated | default: post.date | date_to_xmlschema %}{% if changed > latest %}{% assign latest = changed %}{% endif %}{% endfor %}{% capture href %}href="{{ site.url }}/{% endcapture %}{% capture src %}src="{{ site.url }}/{% endcapture %}<feed xmlns="http://www.w3.org/2005/Atom" xml:base="{{ site.url }}/">
<title>John's website</title>
<link href="{{ site.url }}/"/>
<link rel="self" href="{{ site.url }}/feed.xml"/>
<id>{{ site.url }}/</id>
<updated>{{ latest }}</updated>
<author><name>John</name></author>
{% for post in site.posts %}<entry>
<title>{{ post.title | xml_escape }}</title>
<link href="{{ site.url }}{{ post.url }}"/>
<id>{{ site.url }}{{ post.url }}</id>
<published>{{ post.date | date_to_xmlschema }}</published>
<updated>{{ post.updated | default: post.date | date_to_xmlschema }}</updated>
<content type="html" xml:lang="{{ post.lang | escape }}">{{ post.content | replace: 'href="/', href | replace: 'src="/', src | xml_escape }}</content>
</entry>
{% endfor %}</feed>
